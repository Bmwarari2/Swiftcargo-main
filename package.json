{
  "name": "thapsuscargo",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "cd client && npm install --include=dev && npm run build && cd .. && node scripts/prerender-articles.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:check": "node scripts/migrate.mjs --check",
    "migrate:reconcile": "node scripts/migrate.mjs --reconcile",
    "check:drift": "node scripts/check-schema-drift.mjs",
    "check:drift:snapshot": "node scripts/check-schema-drift.mjs --snapshot",
    "schema:snapshot": "node scripts/check-schema-drift.mjs --write-snapshot",
    "seed:dev": "node scripts/seed-dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "node tests/db-test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "xss": "^1.0.15"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "qs": "^6.15.2",
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "supertest": "^7.1.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  }
}
